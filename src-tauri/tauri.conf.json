{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MilesChessGame",
  "version": "1.0.0",
  "identifier": "com.builtbymiles.mileschessgame",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run web:serve",
    "beforeBuildCommand": "npm run web:copy"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MilesChessGame",
        "width": 1280,
        "height": 820,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.3"
    }
  }
}
