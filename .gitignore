# Dependencies (re-created by `npm install`)
node_modules/

# The copy of the game that gets packed into the app (re-created by `npm run web:copy`)
dist/

# Rust build output: several GB, re-created by `npm run app:build`
src-tauri/target/
# Generated by Tauri on every build
src-tauri/gen/schemas/

# Other build output folders, in case a tool creates one
build/

# Secrets: never commit these. A .env.example with placeholder names is fine.
.env
.env.*
!.env.example

# Editor / OS noise (Mac, Windows, editors)
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.log

# My personal notes: kept on this Mac only
GIT_CHEATSHEET.md
.env.local
*.pem
*.key
